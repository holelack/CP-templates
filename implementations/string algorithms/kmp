bool kmp(string S, string P) {
    int j = 0;
    for (int i = 0; i < S.size(); i++) {
        while (j > 0 && S[i] != P[j]) j = fail[j-1];
        if (S[i] == P[j]) j++;
        if (j == P.size()) {
            return true;
        }
    }
    return false;
}
